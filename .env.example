# Copy to .env. Local demonstration uses SQLite and synthetic people only.
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
APP_ORIGIN=http://localhost:5173
DEMO_MODE=true
# In production set DATABASE_URL, DEMO_MODE=false and generate keys:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DATABASE_URL=
DATA_ENCRYPTION_KEY=
AUTH_PEPPER=
METRICS_TOKEN=
# Staff accounts are provisioned once; no public role assignment.
# STAFF_ACCOUNTS=[{"phone":"+77001234567","name":"Administrator","role":"receptionist"}]
STAFF_ACCOUNTS=[]
# POST JSON { to, text, idempotencyKey } to your contracted SMS gateway.
SMS_GATEWAY_URL=
SMS_GATEWAY_TOKEN=
TELEGRAM_BOT_TOKEN=
PUBLIC_URL=http://localhost:5173
# Production Compose only: use URL-safe hex passwords.
POSTGRES_PASSWORD=
GRAFANA_PASSWORD=
