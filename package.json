{
  "name": "dentlux-portal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "node --env-file-if-exists=.env --watch backend/server.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "build": "vite build",
    "lint": "eslint .",
    "format": "prettier --write frontend backend scripts tests *.mjs *.json docker-compose.yml .github/workflows/ci.yml infra",
    "format:check": "prettier --check frontend backend scripts tests *.mjs *.json docker-compose.yml .github/workflows/ci.yml infra",
    "start": "node --env-file-if-exists=.env backend/server.mjs",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "test:e2e": "playwright test",
    "test:load": "node scripts/load-test.mjs",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "db:import": "node --env-file-if-exists=.env scripts/import-bookings.mjs"
  },
  "dependencies": {
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "pg": "^8.16.3",
    "prom-client": "^15.1.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "ws": "^8.18.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.1",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.39.0",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.13.0",
    "prettier": "^3.6.2",
    "vite": "^7.1.12"
  }
}
